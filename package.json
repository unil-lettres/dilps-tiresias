{
    "name": "dilps-tiresias",
    "private": true,
    "license": "MIT",
    "scripts": {
        "ng": "ng",
        "dev": "pnpm codegen && pnpm set-env && pnpm clean-env && ng serve",
        "dev-docker": "pnpm codegen && pnpm set-env && pnpm clean-env && ng build --configuration=development --watch --output-hashing=all",
        "prod": "pnpm codegen && pnpm set-env --configuration=production && pnpm clean-env && ng build --configuration=production",
        "prod-map": "pnpm codegen && pnpm set-env --configuration=production && pnpm clean-env && ng build --configuration=production,map --output-hashing=none",
        "staging": "pnpm codegen && pnpm set-env --configuration=staging && pnpm clean-env && ng build --configuration=staging",
        "staging-map": "pnpm codegen && pnpm set-env --configuration=staging && pnpm clean-env && ng build --configuration=staging,map --output-hashing=none",
        "test": "pnpm codegen && ng test",
        "lint": "ng lint --max-warnings 0",
        "e2e": "playwright install chromium --with-deps && playwright test",
        "codegen": "./bin/dump-schema && graphql-codegen --config codegen.ts",
        "set-env": "ts-node scripts/setenv.ts",
        "clean-env": "prettier --write client/environments/*",
        "report-build": "bugsnag-build-reporter -n 'Dilps/Tiresias Deployer'"
    },
    "packageManager": "pnpm@11.2.1",
    "dependencies": {
        "@angular/cdk": "^22.1.1",
        "@angular/common": "^22.1.1",
        "@angular/compiler": "^22.1.1",
        "@angular/core": "^22.1.1",
        "@angular/forms": "^22.1.1",
        "@angular/google-maps": "^22.1.1",
        "@angular/localize": "^22.1.1",
        "@angular/material": "^22.1.1",
        "@angular/platform-browser": "^22.1.1",
        "@angular/router": "^22.1.1",
        "@apollo/client": "^4.2.7",
        "@bugsnag/core": "^8.9.0",
        "@bugsnag/js": "^8.9.0",
        "@bugsnag/plugin-angular": "^8.9.0",
        "@ecodev/angular-natural-gallery": "^25.0.0",
        "@ecodev/natural": "72.1.1",
        "@ecodev/natural-layout": "^2.0.6",
        "@fontsource-variable/quicksand": "^5.2.10",
        "@graphql-codegen/cli": "^7.2.0",
        "@graphql-codegen/typescript-operations": "^6.1.5",
        "@graphql-tools/mock": "^9.1.7",
        "@material-symbols/font-400": "^0.45.8",
        "apollo-angular": "^14.1.0",
        "bugsnag-build-reporter": "^2.0.0",
        "dotenv": "^17.4.2",
        "es-toolkit": "^1.48.1",
        "graphql": "^17.0.2",
        "highcharts": "^13.0.0",
        "highcharts-angular": "^5.4.0",
        "ngx-progressbar": "^14.0.0",
        "ngx-quill": "^31.0.1",
        "quill": "^2.0.3",
        "rxjs": "^7.8.2",
        "snazzy-info-window": "^1.1.1",
        "striptags": "4.0.0-alpha.4",
        "tslib": "^2.8.1",
        "type-fest": "^5.7.0",
        "yargs": "^18.0.0",
        "zone.js": "~0.16.2"
    },
    "devDependencies": {
        "@angular/build": "^22.1.3",
        "@angular/cli": "^22.1.3",
        "@angular/compiler-cli": "^22.1.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.0",
        "@types/node": "^22.20.0",
        "angular-eslint": "^22.1.0",
        "eslint": "^10.6.0",
        "jsdom": "^30.0.1",
        "postcss": "^8.5.18",
        "prettier": "3.9.6",
        "prettier-plugin-css-order": "^2.2.0",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.62.0",
        "vitest": "^4.1.10"
    }
}
